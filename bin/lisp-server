#!/bin/sh
# bin/lisp-server start|stop|status -- the always-on SBCL of this project.
# It loads aquarium once, answers Claude on run/lisp.sock, answers Sly where rules/slynk.sexp says, and ticks the tank.
# Started per session by the SessionStart hook in .claude/settings.json; not a launchd job, by design.
here=$(cd "$(dirname "$0")/.." && pwd)
cd "$here" && mkdir -p run
socket=run/lisp.sock
pidfile=run/lisp.pid

# alive = the pid exists and the socket answers a real request (macOS nc has no -z for Unix sockets)
running() { [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null && [ "$(printf T | nc -w 2 -U "$socket" 2>/dev/null)" = "T" ]; }

case "$1" in
  start)
    if running; then echo "lisp-server already running (pid $(cat "$pidfile"))"; exit 0; fi
    [ -f "$here/../tools/quiet-init.lisp" ] || { echo "lisp-server: $here/../tools/quiet-init.lisp is missing (the tree's tools)" >&2; exit 1; }
    rm -f "$socket" "$pidfile"
    # --userinit mutes redefinition warnings about libraries only (UIOP, ASDF, Slynk, Eclector): ../tools/quiet-init.lisp
    nohup bin/qlot exec sbcl --noinform --userinit "$here/../tools/quiet-init.lisp" --non-interactive \
      --eval '(asdf:load-asd (truename "aquarium.asd"))' \
      --load bin/serve.lisp > run/lisp-server.log 2>&1 &
    waited=0
    while ! running; do
      sleep 0.5
      waited=$((waited + 1))
      if [ "$waited" -ge 120 ]; then echo "lisp-server did not come up in 60 s; see run/lisp-server.log" >&2; exit 1; fi
    done
    echo "lisp-server started (pid $(cat "$pidfile"))"
    # Slynk failing to start does not stop the server (it is useful without Sly), but it must not be silent
    case "$(cat run/lisp-server.log)" in
      *"Slynk NOT started"*)
        echo "WARNING: Slynk did not start, so Sly cannot connect: see run/lisp-server.log (the port in rules/slynk.sexp is probably taken)" >&2
        ;;
    esac
    ;;
  stop)
    if [ -f "$pidfile" ]; then
      pid=$(cat "$pidfile")
      kill "$pid" 2>/dev/null
      # wait for it to go: a start straight after a stop must not find the old image still holding the Slynk port.
      # SBCL gives its threads up to 60 s to stop after the signal, so a live image can take about that long.
      waited=0
      while kill -0 "$pid" 2>/dev/null; do
        sleep 0.2
        waited=$((waited + 1))
        if [ "$waited" -ge 350 ]; then echo "lisp-server (pid $pid) did not exit within 70 s" >&2; exit 1; fi
      done
    fi
    rm -f "$socket" "$pidfile"
    echo "lisp-server stopped"
    ;;
  status)
    if running; then echo "running (pid $(cat "$pidfile"))"; else echo "not running"; exit 1; fi
    ;;
  *)
    echo "usage: bin/lisp-server start|stop|status" >&2
    exit 2
    ;;
esac
