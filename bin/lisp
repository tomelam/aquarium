#!/bin/sh
# bin/lisp WORD [ARGS...] -- the one way into this project's Lisp: eval, start, stop, status, test, guard, qlot.
# This file only hands WORD to the script `lisp` of the shared tools (github.com/tomelam/lisp-ai-tools), which Qlot installs
# inside this project at .qlot/dists/lisp-ai-tools/software/lisp-ai-tools-ref-<commit>/lisp; distinfo.txt names the commit.
# In that script each word is a shell function: start is start_server, which runs SBCL on bin/serve.lisp. The name on the
# last line is this project's ASDF system. (Qlot drops the executable bit of the files it installs, so the script is run by sh.)
cd "$(dirname "$0")/.." || exit 1
dist=.qlot/dists/lisp-ai-tools
while read -r key value; do [ "$key" = version: ] && version=${value#git-}; done < "$dist/distinfo.txt"
exec sh "$dist/software/lisp-ai-tools-ref-$version/lisp" aquarium "$@"
