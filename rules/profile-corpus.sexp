;; Commands for probing the deny list (tools/profile.lisp). Each is harmless to run: its arguments are /dev/null and it writes
;; nothing. This project has no guard, so the shadow switch does nothing here; run one command with the Bash tool, character
;; for character, while profiling is on, and the profile log shows whether the deny list stopped it. Add a command when the log
;; shows a form that got through.
("cat /dev/null"
 "head -n 1 /dev/null"
 "wc -l /dev/null"
 "grep x /dev/null"
 "sed -n 1p /dev/null"
 "python3 -c pass"
 "ls /dev/null | wc -l"
 "ls /dev/null && cat /dev/null"
 "FOO=1 grep x /dev/null"
 "echo $(cat /dev/null)"
 "echo \"$(cat /dev/null)\""
 "(cat /dev/null)"
 "timeout 5 grep x /dev/null"
 "nice -n 5 grep x /dev/null"
 "timeout -k 5 10 grep x /dev/null"
 "xargs grep x < /dev/null"
 "echo /dev/null | xargs cat"
 "echo /dev/null | xargs -I {} cat {}"
 "echo /dev/null | xargs -n1 grep x"
 "env FOO=1 sed -n 1p /dev/null"
 "sudo -n cat /dev/null"
 "eval 'sed -n 1p /dev/null'"
 "/usr/bin/sed -n 1p /dev/null"
 "/bin/cat /dev/null"
 "'cat' /dev/null"
 "sh -c 'cat /dev/null'"
 "bash -c 'cat /dev/null'"
 "find /dev/null -exec cat {} +"
 "for f in /dev/null; do cat $f; done"
 "if true; then cat /dev/null; fi"
 "{ cat /dev/null; }"
 "! grep x /dev/null"
 "cat</dev/null"
 "echo sed"
 "ls /dev/null"
 "git status")
